{
  "manifest_version": 3,
  "name": "Smart YouTube Comment Analyzer",
  "version": "1.0",
  "description": "Analyzes YouTube comments to evaluate video quality.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}